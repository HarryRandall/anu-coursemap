{
  "name": "anu-coursemap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts",
    "catalogue:fetch": "node scripts/catalogue/fetch-anu-manifest.mjs",
    "catalogue:import": "node scripts/catalogue/import-manifest.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern .next",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test:unit && npm run test:build:demo && npm run test:rendered && npm run test:build:auth && npm run test:auth-access",
    "test:unit": "node --test tests/auth-redirect.test.mjs tests/auth-config.test.mjs tests/catalogue-fetch-cli.test.mjs tests/catalogue-import-cli.test.mjs tests/catalogue-import-local-database.test.mjs tests/catalogue-import-parser.test.mjs tests/dashboard-series.test.mjs tests/plan-timeline.test.mjs tests/planner.test.mjs tests/requisite-summary.test.mjs",
    "test:catalogue-db": "node --test tests/catalogue-import-database-integration.test.mjs",
    "test:build:demo": "COURSEMAP_DEMO_MODE=true NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3217 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test npm run build",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:build:auth": "COURSEMAP_DEMO_MODE=false NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3218 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test npm run build",
    "test:auth-access": "node --test tests/auth-access.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run check && npm test && git diff --check"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "cheerio": "1.1.2",
    "geist": "1.7.2",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
