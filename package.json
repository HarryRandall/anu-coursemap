{
  "name": "coursemap",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "pnpm --filter @coursemap/web dev:local",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:e2e": "pnpm --filter @coursemap/web test:e2e:build && pnpm --filter @coursemap/web test:e2e",
    "verify": "pnpm check && pnpm test && pnpm --filter @coursemap/web test:build:demo && pnpm --filter @coursemap/web test:rendered && pnpm --filter @coursemap/web test:build:auth && pnpm --filter @coursemap/web test:auth-access && git diff --check",
    "db:start": "pnpm --filter @coursemap/web db:start",
    "db:reset": "pnpm --filter @coursemap/web db:reset",
    "db:seed:preview": "pnpm --filter @coursemap/web db:seed:preview",
    "db:test": "pnpm --filter @coursemap/web db:test",
    "db:lint": "pnpm --filter @coursemap/web db:lint",
    "db:types": "pnpm --filter @coursemap/web db:types",
    "db:storage:buckets:linked": "pnpm --filter @coursemap/web db:storage:buckets:linked",
    "calendar:fetch": "pnpm --filter @coursemap/web calendar:fetch",
    "calendar:import": "pnpm --filter @coursemap/web calendar:import",
    "course-import:benchmark": "pnpm --filter @coursemap/web course-import:benchmark",
    "rooms:buildings:fetch": "pnpm --filter @coursemap/web rooms:buildings:fetch",
    "rooms:buildings:generate": "pnpm --filter @coursemap/web rooms:buildings:generate",
    "test:catalogue-db": "pnpm --filter @coursemap/web test:catalogue-db"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
