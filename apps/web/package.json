{
  "name": "@coursemap/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "dev:local": "node scripts/local/dev-preview.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "db:start": "supabase --workdir ../.. start",
    "db:reset": "node scripts/local/reset-preview.mjs",
    "db:seed:preview": "node scripts/local/seed-preview.mjs",
    "db:test": "supabase --workdir ../.. test db",
    "db:lint": "supabase --workdir ../.. db lint --local --schema public,private --level warning --fail-on warning",
    "db:types": "supabase --workdir ../.. gen types typescript --local --schema public > types/database.ts",
    "db:storage:buckets:linked": "supabase --workdir ../.. seed buckets --linked",
    "calendar:fetch": "node scripts/catalogue/fetch-anu-calendar.mjs",
    "calendar:import": "node scripts/catalogue/import-calendar.mjs",
    "course-import:benchmark": "node --env-file-if-exists=.env.local scripts/catalogue/benchmark-course-models.mjs",
    "rooms:buildings:fetch": "node scripts/rooms/sync-anu-buildings.mjs fetch",
    "rooms:buildings:generate": "node scripts/rooms/sync-anu-buildings.mjs generate",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern .next",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm test:unit",
    "test:structure": "vitest run tests/plan-catalogue-requirements.test.mjs",
    "test:unit": "vitest run --project unit --project component",
    "test:catalogue-db": "vitest run --project database",
    "test:build:demo": "COURSEMAP_DEMO_MODE=true COURSEMAP_QUEUE_IMPORTS_ENABLED=false NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4217 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test pnpm build",
    "test:rendered": "COURSEMAP_TEST_PROFILE=demo playwright test",
    "test:build:auth": "COURSEMAP_DEMO_MODE=false NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4218 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test pnpm build",
    "test:auth-access": "COURSEMAP_TEST_PROFILE=access playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "COURSEMAP_TEST_PROFILE=authenticated playwright test",
    "test:e2e:build": "node scripts/local/build-e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/queue": "0.5.1",
    "@xyflow/react": "12.11.5",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "geist": "1.7.2",
    "highlight.js": "11.12.0",
    "lucide-react": "1.34.0",
    "maplibre-gl": "^6.6.0",
    "motion": "12.43.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.2",
    "@coursemap/ui": "workspace:*",
    "domhandler": "5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "30.0.1",
    "@types/geojson": "7946.0.16"
  },
  "type": "module"
}
