# Browser-safe Supabase settings. These values are safe to expose by design.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public origin used for auth redirects and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public vector style URL for Room Finder. The default is OpenFreeMap.
NEXT_PUBLIC_ROOM_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional public elevation tiles for Room Finder terrain and hillshade.
NEXT_PUBLIC_ROOM_MAP_TERRAIN_URL=https://tiles.mapterhorn.com/tilejson.json

# Optional server-side OSRM-compatible foot routing endpoint for Room Finder.
ROOM_MAP_ROUTING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving

# Explicitly opt into local demo fixtures. Keep this false for real accounts.
COURSEMAP_DEMO_MODE=false

# Server-only database connection used by the authenticated Vercel import
# runner. Use a hosted Supabase PostgreSQL connection URL. Never expose this
# value to browser code or commit it to an env file.
COURSEMAP_IMPORT_DATABASE_URL=

# Server-only Supabase secret key used by the durable import worker to write
# immutable artefacts to the private course-import-artifacts bucket. Use an
# sb_secret_ key for the same project as NEXT_PUBLIC_SUPABASE_URL. Never expose
# this value to browser code or commit it to an env file.
SUPABASE_SECRET_KEY=

# Server-only OpenRouter key dedicated to course extraction. Create a separate
# key with a hard $3 limit. The worker must stop instead of falling back to a
# different key when this key is unavailable or exhausted.
OPENROUTER_API_KEY=

# Keep queue publishing disabled until the pipeline migration, worker route and
# secrets have all been deployed. Vercel Queues itself uses Vercel OIDC, so it
# does not require a separate queue credential.
COURSEMAP_QUEUE_IMPORTS_ENABLED=false

# Optional comma-separated allowlist shown in the administrator model picker.
# The first model is the default. Keep the inexpensive structured-output model
# first unless an administrator deliberately changes it.
COURSEMAP_OPENROUTER_MODELS=google/gemini-3.1-flash-lite

# Optional loopback-only override for the catalogue import scripts in
# scripts/catalogue. When unset, the scripts discover the local Supabase
# database from supabase/config.toml. DATABASE_URL is honoured as a fallback;
# hosted database URLs are refused.
COURSEMAP_DATABASE_URL=
