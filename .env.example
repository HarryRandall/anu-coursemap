# Browser-safe Supabase settings. These values are safe to expose by design.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public origin used for auth redirects and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public vector style URL for Room Finder. The default is OpenFreeMap.
NEXT_PUBLIC_ROOM_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional server-side OSRM-compatible foot routing endpoint for Room Finder.
ROOM_MAP_ROUTING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving

# Explicitly opt into local demo fixtures. Keep this false for real accounts.
COURSEMAP_DEMO_MODE=false

# Server-only database connection used by the authenticated Vercel import
# runner. Use a hosted Supabase PostgreSQL connection URL. Never expose this
# value to browser code or commit it to an env file.
COURSEMAP_IMPORT_DATABASE_URL=

# Optional loopback-only override for the catalogue import scripts in
# scripts/catalogue. When unset, the scripts discover the local Supabase
# database from supabase/config.toml. DATABASE_URL is honoured as a fallback;
# hosted database URLs are refused.
COURSEMAP_DATABASE_URL=
