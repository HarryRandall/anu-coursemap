{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".node-version",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "scripts/**"
  ],
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "COURSEMAP_*",
    "ROOM_MAP_*",
    "SUPABASE_*",
    "OPENROUTER_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:catalogue-db": {
      "cache": false,
      "dependsOn": ["^typecheck"]
    }
  }
}
